{
  "name": "@ko-io/sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the ko.io financial data API — SEC 13F institutional holdings, insider trades, congress trading, crypto ETF exposure and macro data.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SharpLu/ko-mcp.git",
    "directory": "typescript/sdk"
  },
  "homepage": "https://ko.io",
  "keywords": [
    "sec",
    "13f",
    "edgar",
    "insider-trading",
    "congress-trading",
    "financial-data",
    "institutional-holdings",
    "api-client"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
