{
  "name": "@ko-io/mcp-sec-data",
  "version": "0.1.0",
  "description": "Local stdio MCP server that proxies to the hosted ko.io MCP server (SEC 13F, insider trades, congress trading, crypto ETF exposure, macro data).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ko-mcp-sec-data": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SharpLu/ko-mcp.git",
    "directory": "typescript/mcp-proxy"
  },
  "homepage": "https://ko.io",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sec",
    "13f",
    "insider-trading",
    "congress-trading",
    "financial-data",
    "stdio"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
